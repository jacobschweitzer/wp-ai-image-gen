{
	"name": "kaigen",
	"version": "0.2.11",
	"description": "A plugin to generate images using AI.",
	"author": "Jacob Schweitzer",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"engines": {
		"node": ">=22.13 <23",
		"npm": ">=10"
	},
	"scripts": {
		"build": "wp-scripts build src/index.js",
		"build:base": "npm run build",
		"build:main": "npm run build:base",
		"build:premium": "npm run build --prefix premium/kaigen-premium",
		"build:all": "npm run build:base && npm run build:premium",
		"build:check": "npm run build:all && node scripts/check-build-parity.js",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:php": "composer exec phpcs",
		"lint:php:fix": "composer exec phpcbf",
		"test:php": "composer exec phpunit",
		"test:php:coverage": "node scripts/run-php-coverage.js",
		"test:php:coverage-threshold": "node --test scripts/php-coverage-threshold.test.js",
		"test:php:static": "composer exec phpstan",
		"test:php:complexity": "composer exec phpmd -- inc text phpmd.xml",
		"test:php:mutation": "infection --configuration=infection.json5 --threads=1 --no-interaction --no-ansi",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start src/index.js",
		"test:unit": "npm run test:unit:base",
		"test:unit:base": "wp-scripts test-unit-js --config jest.config.js",
		"test:unit:coverage": "npm run test:coverage",
		"test:coverage": "wp-scripts test-unit-js --config jest.config.js --coverage",
		"test:mutation:js": "stryker run",
		"test:build-parity": "node --test scripts/check-build-parity.test.js",
		"test:unit:premium": "npm run test:unit --prefix premium/kaigen-premium",
		"test:fast": "npm run test:unit:base && npm run test:unit:premium && npm run test:php && npm run test:e2e:launcher && npm run test:build-parity && npm run test:php:coverage-threshold",
		"playground:start": "node scripts/playground-server.js",
		"test:e2e": "npm run test:e2e:all",
		"test:e2e:all": "npm run test:e2e:base && npm run test:e2e:reference && npm run test:e2e:generation && npm run test:e2e:contract && npm run test:e2e:premium",
		"test:e2e:base": "node scripts/run-e2e.js --grep-invert \"@generation|@reference|@contract\"",
		"test:e2e:ci": "npm run test:e2e:base -- --project=chromium --artifact-name=base && npm run test:e2e:reference -- --project=chromium --artifact-name=reference && npm run test:e2e:generation -- --project=chromium --artifact-name=generation && npm run test:e2e:contract -- --project=chromium --artifact-name=contract && npm run test:e2e:premium -- --project=chromium --artifact-name=premium",
		"test:e2e:contract": "node scripts/run-e2e.js --playground-blueprint=.github/blueprints/e2e-ai-client-contract.json --grep @contract",
		"test:e2e:debug": "node scripts/run-e2e.js --grep-invert \"@generation|@reference|@contract\" --debug",
		"test:e2e:generation": "node scripts/run-e2e.js --playground-blueprint=.github/blueprints/e2e-generation-mocked.json --grep @generation",
		"test:e2e:launcher": "node --test scripts/run-e2e.test.js scripts/child-process.test.js",
		"test:e2e:premium": "node scripts/run-e2e.js --playground-blueprint=.github/blueprints/e2e-premium-generation.json --config=playwright.premium.config.ts --grep @generation",
		"test:e2e:reference": "node scripts/run-e2e.js --playground-blueprint=.github/blueprints/e2e-reference-media.json --grep @reference",
		"test:e2e:smoke": "node scripts/run-e2e.js --grep @smoke",
		"test:e2e:ui": "node scripts/run-e2e.js --grep-invert \"@generation|@reference|@contract\" --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/jest-runner": "^9.6.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20.17.10",
		"@wordpress/e2e-test-utils-playwright": "^1.46.0",
		"@wordpress/jest-preset-default": "^12.51.0",
		"@wordpress/scripts": "^32.2.0",
		"@wp-playground/cli": "^3.1.35",
		"dotenv": "^17.4.2"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.46.0",
		"@wordpress/block-editor": "^15.19.0",
		"@wordpress/components": "^33.1.0",
		"@wordpress/data": "^10.46.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/hooks": "^4.46.0"
	}
}
